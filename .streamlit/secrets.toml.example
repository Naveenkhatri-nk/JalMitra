# JalMitra secrets - EXAMPLE ONLY (safe to upload: it has no real values).
#
# On your computer: copy this file to .streamlit/secrets.toml and fill it in (secrets.toml is in .gitignore and is
#                   never uploaded to GitHub).
# On Streamlit Community Cloud: open your app -> Settings -> Secrets, and paste the same text there.

# ---- Cloud AI (optional, for the public website; your computer keeps using Ollama when these are not set).
# Top-level values are also given to the app as environment variables by Streamlit Cloud.
# Example: Groq (free key at https://console.groq.com/keys), an OpenAI-compatible service.
# JALMITRA_LLM_PROVIDER = "openai_compatible"
# JALMITRA_LLM_BASE_URL = "https://api.groq.com/openai/v1"
# JALMITRA_LLM_MODEL    = "llama-3.3-70b-versatile"
# JALMITRA_LLM_API_KEY  = "paste-your-key-here"

[auth]
# Accounts database. Leave empty on your computer (a local file data/users/jalmitra_users.db is used).
# On the internet use a free hosted PostgreSQL database, for example Neon (https://neon.tech): copy its
# "connection string", it looks like this:
database_url = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# A long random text that keys the hashes in the security log. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
secret_key = "paste-a-long-random-text-here"

# Emails that become admins (they see the Admin page). Use your own email.
admin_emails = ["your.email@example.com"]

# true = anyone can create an account; false = only existing users can log in.
allow_signup = true

# Logged-in users are logged out after this many minutes without using the app, and after this many hours in total.
session_idle_minutes = 60
session_max_hours = 12

# Email for "Forgot password" codes (optional). Example: a Gmail account with an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
[auth.smtp]
host = ""            # for Gmail: "smtp.gmail.com"
port = 587
user = ""            # the Gmail address
password = ""        # the 16-letter App Password (NOT your normal Gmail password)
sender = ""          # the address the email comes from, e.g. "JalMitra <you@gmail.com>"
